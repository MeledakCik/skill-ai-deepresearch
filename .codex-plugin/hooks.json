{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'.codex-plugin','cache_guard.py'),run_name='__main__')\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'.codex-plugin','cache_guard.py'),run_name='__main__')\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
